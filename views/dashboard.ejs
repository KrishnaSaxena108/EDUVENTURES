<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduVentures - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="shortcut icon" href="./assets/images/favicon.svg" type="image/svg+xml">
    <style>
        :root {
            --primary: #1a1a2e;
            --secondary: #16213e;
            --secondary-highlight: #6B9EFF;
            --accent: #0f3460;
            --text-primary: #ffffff;
            --text-secondary: #b8bcc8;
            --text-muted: #8892b0;
            --surface: #0d1421;
            --surface-light: rgba(107, 158, 255, 0.1);
            --border: rgba(107, 158, 255, 0.2);
            --shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            --shadow-hover: 0 12px 48px rgba(107, 158, 255, 0.15);
            --gradient: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            --border-radius: 16px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --success: #10b981;
            --warning: #f59e0b;
            --error: #ef4444;
            --info: #3b82f6;
        }

        /* Light Mode Variables */
        [data-theme="light"] {
            --primary: #ffffff;
            --secondary: #f8fafc;
            --secondary-highlight: #4f46e5;
            --accent: #e5e7eb;
            --text-primary: #1f2937;
            --text-secondary: #4b5563;
            --text-muted: #6b7280;
            --surface: #f9fafb;
            --surface-light: rgba(79, 70, 229, 0.05);
            --border: rgba(79, 70, 229, 0.1);
            --shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            --shadow-hover: 0 12px 48px rgba(79, 70, 229, 0.15);
            --gradient: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--surface);
            color: var(--text-primary);
            line-height: 1.6;
            overflow-x: hidden;
            transition: var(--transition);
        }

        /* Background Pattern */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background:
                radial-gradient(circle at 20% 20%, rgba(107, 158, 255, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(107, 158, 255, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 40% 60%, rgba(107, 158, 255, 0.05) 0%, transparent 50%);
            pointer-events: none;
            z-index: -1;
            transition: var(--transition);
        }

        [data-theme="light"] body::before {
            background:
                radial-gradient(circle at 20% 20%, rgba(79, 70, 229, 0.05) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(79, 70, 229, 0.05) 0%, transparent 50%),
                radial-gradient(circle at 40% 60%, rgba(79, 70, 229, 0.03) 0%, transparent 50%);
        }

        /* Header */
        .header {
            background: var(--gradient);
            padding: 1rem 2rem;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            box-shadow: var(--shadow);
            transition: var(--transition);
        }

        .header-content {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .logo {
            width: 40px;
            height: 40px;
            background: var(--secondary-highlight);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            font-weight: 700;
        }

        .brand-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .user-section {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .user-greeting {
            font-weight: 500;
            color: var(--text-secondary);
        }

        .logout-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: var(--text-primary);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .logout-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-1px);
        }

        [data-theme="light"] .logout-btn {
            background: var(--surface-light);
            border: 1px solid var(--border);
            color: var(--text-primary);
        }

        [data-theme="light"] .logout-btn:hover {
            background: var(--accent);
        }

        /* Theme Toggle */
        .theme-toggle {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: var(--text-primary);
            padding: 0.5rem;
            border-radius: 8px;
            font-size: 1rem;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            position: relative;
        }

        .theme-toggle:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-1px);
        }

        [data-theme="light"] .theme-toggle {
            background: var(--surface-light);
            border: 1px solid var(--border);
            color: var(--text-primary);
        }

        [data-theme="light"] .theme-toggle:hover {
            background: var(--accent);
        }

        /* Professional theme toggle icons */
        .theme-toggle {
            position: relative;
        }

        .theme-toggle .theme-icon {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .theme-toggle .fa-moon {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1) rotate(0deg);
        }

        .theme-toggle .fa-sun {
            opacity: 0;
            transform: translate(-50%, -50%) scale(0.8) rotate(90deg);
        }

        [data-theme="light"] .theme-toggle .fa-moon {
            opacity: 0;
            transform: translate(-50%, -50%) scale(0.8) rotate(-90deg);
        }

        [data-theme="light"] .theme-toggle .fa-sun {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1) rotate(0deg);
        }

        /* Main Content */
        .main-content {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .dashboard-title {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--secondary-highlight), #4a90e2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
        }

        .dashboard-subtitle {
            font-size: 1.1rem;
            color: var(--text-muted);
        }

        /* Dashboard Grid */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 350px 1fr;
            gap: 2rem;
            margin-bottom: 3rem;
        }

        /* Profile Card */
        .profile-card {
            background: var(--gradient);
            border-radius: var(--border-radius);
            padding: 2rem;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            transition: var(--transition);
            height: fit-content;
        }

        .profile-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

        .profile-avatar {
            width: 100px;
            height: 100px;
            background: var(--secondary-highlight);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            box-shadow: 0 8px 24px rgba(107, 158, 255, 0.3);
        }

        .avatar-icon {
            font-size: 2.5rem;
            color: white;
        }

        .profile-name {
            font-size: 1.5rem;
            font-weight: 600;
            text-align: center;
            margin-bottom: 0.5rem;
            color: var(--text-primary);
        }

        .profile-email {
            text-align: center;
            color: var(--text-secondary);
            margin-bottom: 2rem;
        }

        .profile-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-item {
            background: rgba(255, 255, 255, 0.1);
            padding: 1rem;
            border-radius: 12px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: var(--transition);
        }

        [data-theme="light"] .stat-item {
            background: var(--surface-light);
            border: 1px solid var(--border);
        }

        .stat-number {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--secondary-highlight);
            display: block;
        }

        .stat-label {
            font-size: 0.8rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .cta-button {
            width: 100%;
            background: var(--secondary-highlight);
            color: white;
            border: none;
            padding: 1rem;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .cta-button:hover {
            background: #5a8ff0;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(107, 158, 255, 0.4);
        }

        /* Bookings Section */
        .bookings-container {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .section-count {
            background: var(--secondary-highlight);
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        /* Booking Cards */
        .bookings-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 1.5rem;
        }

        .booking-card {
            background: var(--gradient);
            border-radius: var(--border-radius);
            overflow: hidden;
            border: 1px solid var(--border);
            transition: var(--transition);
            box-shadow: var(--shadow);
            position: relative;
        }

        .booking-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }

        .booking-status {
            position: absolute;
            top: 1rem;
            right: 1rem;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            z-index: 2;
        }

        .status-confirmed {
            background: var(--success);
            color: white;
        }

        .status-pending {
            background: var(--warning);
            color: white;
        }

        .status-cancelled {
            background: var(--error);
            color: white;
        }

        .booking-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
            background: var(--surface-light);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            font-size: 3rem;
        }

        .booking-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .booking-content {
            padding: 1.5rem;
        }

        .booking-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
        }

        .booking-subtitle {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .booking-details {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .booking-detail {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        .booking-detail i {
            color: var(--secondary-highlight);
            width: 16px;
            text-align: center;
        }

        .booking-footer {
            padding: 1rem 1.5rem;
            background: rgba(255, 255, 255, 0.05);
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        [data-theme="light"] .booking-footer {
            background: var(--surface-light);
        }

        .booking-id {
            font-size: 0.8rem;
            color: var(--text-muted);
            font-family: 'Courier New', monospace;
        }

        .booking-amount {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--secondary-highlight);
        }

        /* Empty State */
        .empty-state {
            background: var(--gradient);
            border: 2px dashed var(--border);
            border-radius: var(--border-radius);
            padding: 3rem;
            text-align: center;
            color: var(--text-muted);
            transition: var(--transition);
        }

        .empty-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            color: var(--secondary-highlight);
        }

        .empty-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--text-secondary);
        }

        .empty-text {
            margin-bottom: 1.5rem;
        }

        /* Footer */
        .footer {
            background: var(--primary);
            padding: 2rem;
            text-align: center;
            margin-top: 4rem;
            border-top: 1px solid var(--border);
            transition: var(--transition);
        }

        .footer-text {
            color: var(--text-secondary);
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .dashboard-grid {
                grid-template-columns: 1fr;
            }

            .profile-card {
                margin-bottom: 2rem;
            }
        }

        @media (max-width: 768px) {
            .main-content {
                padding: 1rem;
            }

            .dashboard-title {
                font-size: 2rem;
            }

            .header-content {
                flex-wrap: wrap;
                gap: 1rem;
            }

            .user-section {
                gap: 1rem;
            }

            .user-greeting {
                display: none;
            }

            .bookings-grid {
                grid-template-columns: 1fr;
            }

            .profile-stats {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 480px) {
            .header {
                padding: 1rem;
            }

            .header-content {
                flex-direction: column;
                gap: 1rem;
            }

            .user-section {
                justify-content: center;
            }
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes slideInFromLeft {
            from {
                opacity: 0;
                transform: translateX(-30px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes slideInFromRight {
            from {
                opacity: 0;
                transform: translateX(30px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .dashboard-header {
            animation: fadeInUp 0.6s ease-out forwards;
        }

        .profile-card {
            animation: slideInFromLeft 0.6s ease-out forwards;
            animation-delay: 0.1s;
        }

        .bookings-container {
            animation: slideInFromRight 0.6s ease-out forwards;
            animation-delay: 0.2s;
        }

        .booking-card {
            animation: fadeInUp 0.6s ease-out forwards;
        }

        .booking-card:nth-child(1) {
            animation-delay: 0.3s;
        }

        .booking-card:nth-child(2) {
            animation-delay: 0.4s;
        }

        .booking-card:nth-child(3) {
            animation-delay: 0.5s;
        }

        .empty-state {
            animation: fadeInUp 0.6s ease-out forwards;
            animation-delay: 0.3s;
        }

        /* Additional Interactive Effects */
        .booking-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg,
                    rgba(107, 158, 255, 0.1) 0%,
                    rgba(107, 158, 255, 0.05) 50%,
                    transparent 100%);
            opacity: 0;
            transition: var(--transition);
            pointer-events: none;
        }

        .booking-card:hover::before {
            opacity: 1;
        }

        .stat-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(107, 158, 255, 0.2);
        }

        [data-theme="light"] .stat-item:hover {
            box-shadow: 0 4px 16px rgba(79, 70, 229, 0.1);
        }
    </style>
</head>

<body>
    <header class="header">
        <div class="header-content">
            <div class="logo-section">
                <div class="logo"><img src="assets/images/favicon.svg" height="50"></div>
                <span class="brand-name">EduVentures</span>
            </div>
            <div class="user-section">
                <span class="user-greeting">Welcome, <%= user.name %></span>
                <button id="themeToggle" class="theme-toggle">
                    <i class="fas fa-moon theme-icon" aria-hidden="true"></i>
                    <i class="fas fa-sun theme-icon" aria-hidden="true"></i>
                </button>
                <a href="/logout" class="logout-btn">
                    <i class="fas fa-sign-out-alt"></i>
                    Logout
                </a>
            </div>
        </div>
    </header>

    <main class="main-content">
        <div class="dashboard-header">
            <h1 class="dashboard-title">Your Adventure Dashboard</h1>
            <p class="dashboard-subtitle">Manage your bookings and explore new destinations</p>
        </div>

        <div class="dashboard-grid">
            <div class="profile-card">
                <div class="profile-avatar">
                    <i class="fas fa-user avatar-icon"></i>
                </div>
                <h2 class="profile-name">
                    <%= user.name %>
                </h2>
                <p class="profile-email">
                    <%= user.email %>
                </p>

                <div class="profile-stats">
                    <div class="stat-item">
                        <span class="stat-number">
                            <%= bookings.length %>
                        </span>
                        <span class="stat-label">Total Bookings</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">
                            <%= bookings.filter(booking=> new Date(booking.startDate) > new Date()).length %>
                        </span>
                        <span class="stat-label">Upcoming Trips</span>
                    </div>
                </div>

                <a href="/booknow" class="cta-button">
                    <i class="fas fa-plus"></i>
                    Book New Adventure
                </a>
            </div>

            <div class="bookings-container">
                <div class="section-header">
                    <h3 class="section-title">Your Bookings</h3>
                    <span class="section-count">
                        <%= bookings.length %>
                    </span>
                </div>

                <% if (bookings && bookings.length> 0) { %>
                    <div class="bookings-grid">
                        <% bookings.forEach(booking=> {
                            const travelDate = new Date(booking.startDate);
                            const today = new Date();
                            const isUpcoming = travelDate > today;
                            const isPast = travelDate < today; %>
                                <div class="booking-card">
                                    <div class="booking-image">
                                        <i class="fas fa-map-marked-alt"></i>
                                    </div>

                                    <div class="booking-content">
                                        <h4 class="booking-title">
                                            <%= booking.destination || 'Adventure Package' %>
                                        </h4>
                                        <p class="booking-subtitle">
                                            <%= booking.tourType || 'Educational Tour' %>
                                        </p>
                                        <div class="booking-details">
                                            <div class="booking-detail">
                                                <i class="fas fa-users"></i>
                                                <span>
                                                    <%= booking.numPeople %> People
                                                </span>
                                            </div>
                                            <div class="booking-detail">
                                                <i class="fas fa-calendar-alt"></i>
                                                <span>
                                                    <%= travelDate.toLocaleDateString('en-US', { year: 'numeric' ,
                                                        month: 'long' , day: 'numeric' }) %>
                                                </span>
                                            </div>
                                            <div class="booking-detail">
                                                <i class="fas fa-clock"></i>
                                                <span>
                                                    <% if (isUpcoming) { %>
                                                        <strong style="color: var(--success);">Upcoming</strong>
                                                        <% } else if (isPast) { %>
                                                            <strong style="color: var(--text-muted);">Completed</strong>
                                                            <% } else { %>
                                                                <strong style="color: var(--warning);">Today</strong>
                                                                <% } %>
                                                </span>
                                            </div>
                                            <div class="booking-detail">
                                                <i class="fas fa-calendar-check"></i>
                                                <span>
                                                    Booked: <%= new
                                                        Date(booking.bookingDate).toLocaleDateString('en-US', {
                                                        year: 'numeric' , month: 'short' , day: 'numeric' }) %>
                                                </span>
                                            </div>
                                            <% if (booking.specialRequests) { %>
                                                <div class="booking-detail">
                                                    <i class="fas fa-sticky-note"></i>
                                                    <span>
                                                        <%= booking.specialRequests %>
                                                    </span>
                                                </div>
                                                <% } %>
                                        </div>
                                    </div>

                                    <div class="booking-footer">
                                        <span class="booking-id">ID: <%= booking._id.toString().slice(-8).toUpperCase()
                                                %></span>
                                        <span class="booking-amount">₹<%= booking.totalPrice || 'N/A' %></span>
                                    </div>
                                </div>
                                <% }); %>
                    </div>
                    <% } else { %>
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fas fa-ticket-alt"></i>
                            </div>
                            <h4 class="empty-title">No Bookings Yet</h4>
                            <p class="empty-text">You haven't made any bookings yet. Start your adventure today!</p>
                            <a href="/booknow" class="cta-button" style="width: auto; padding: 0.75rem 1.5rem;">
                                <i class="fas fa-plus"></i>
                                Book Your First Adventure
                            </a>
                        </div>
                        <% } %>
            </div>
        </div>
    </main>

    <footer class="footer">
        <p class="footer-text">&copy; <%= new Date().getFullYear() %> EduVentures. All rights reserved.</p>
    </footer>

    <script>
        // In-memory theme storage
        let currentTheme = 'dark';

        // Theme toggle functionality
        const themeToggle = document.getElementById('themeToggle');
        const body = document.body;

        // Set default theme
        body.setAttribute('data-theme', currentTheme);

        themeToggle.addEventListener('click', () => {
            currentTheme = currentTheme === 'dark' ? 'light' : 'dark';
            body.setAttribute('data-theme', currentTheme);
        });

        // Add interactive effects to booking cards
        document.querySelectorAll('.booking-card').forEach((card, index) => {
            card.addEventListener('mouseenter', () => {
                card.style.transform = 'translateY(-8px) scale(1.02)';
                card.style.zIndex = '10';
            });

            card.addEventListener('mouseleave', () => {
                card.style.transform = '';
                card.style.zIndex = '';
            });

            // Stagger animation delays
            card.style.animationDelay = `${0.3 + (index * 0.1)}s`;
        });

        // Add interactive effects to stat items
        document.querySelectorAll('.stat-item').forEach(item => {
            item.addEventListener('mouseenter', () => {
                item.style.transform = 'translateY(-4px) scale(1.05)';
            });

            item.addEventListener('mouseleave', () => {
                item.style.transform = '';
            });
        });

        // Smooth scroll for navigation
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add loading animation to CTA buttons
        document.querySelectorAll('.cta-button').forEach(button => {
            button.addEventListener('click', function (e) {
                if (this.href && this.href.includes('/booknow')) {
                    const originalText = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading...';
                    this.style.pointerEvents = 'none';

                    // Reset after a short delay (in case navigation is slow)
                    setTimeout(() => {
                        this.innerHTML = originalText;
                        this.style.pointerEvents = '';
                    }, 3000);
                }
            });
        });

        // Add subtle parallax effect to background
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            const parallax = document.body;
            const speed = scrolled * 0.5;

            parallax.style.backgroundPosition = `center ${speed}px`;
        });

        // Add booking status color animation
        document.querySelectorAll('.booking-status').forEach(status => {
            status.addEventListener('mouseenter', () => {
                status.style.transform = 'scale(1.1)';
                status.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.3)';
            });

            status.addEventListener('mouseleave', () => {
                status.style.transform = '';
                status.style.boxShadow = '';
            });
        });

        // Add counter animation for stats
        function animateCounter(element, target) {
            const duration = 1000;
            const start = 0;
            const increment = target / (duration / 16);
            let current = start;

            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    element.textContent = target;
                    clearInterval(timer);
                } else {
                    element.textContent = Math.floor(current);
                }
            }, 16);
        }

        // Initialize counter animations when page loads
        window.addEventListener('load', () => {
            document.querySelectorAll('.stat-number').forEach(stat => {
                const target = parseInt(stat.textContent);
                stat.textContent = '0';
                setTimeout(() => {
                    animateCounter(stat, target);
                }, 500);
            });
        });
    </script>
</body>

</html>